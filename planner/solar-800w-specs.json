  "parts": [
    {
      "name": "HQST HSP200N-64L 200 W panels",
      "quantity": "4",
      "decision": "Selected · new",
      "visible": true,
      "detail": "800 W total; four in series. Each 1175 × 765 × 30 mm, 9.15 kg. Four weigh 36.6 kg / 80.7 lb before supports. Existing panels are replaced in this preview.",
      "source": "https://cdn.shopify.com/s/files/1/0938/4627/4366/files/HSP200N-64L_-_Manual.pdf?v=1779096675"
    },
    {
      "name": "Raised crossbars, risers & panel clamps",
      "quantity": "Final quantity / model TBD",
      "decision": "Required · unresolved",
      "visible": true,
      "detail": "The compact layout has sixteen generic riser brackets on eight raised spans; counts change with panel positions. This is an illustration, not a selected hardware kit. Unaka 7.5-inch was a review candidate; rail interface, height datum, load rating and hardware still need confirmation. The rear 2×2 preset instead has eight generic risers on four raised spans. User planning overhang allowances are editable; physical mounting permission remains unverified.",
      "source": "https://unakagearco.com/products/unaka-high-bar-bracket-kits"
    },
    {
      "name": "Victron SmartSolar 150/35",
      "quantity": "Existing 1",
      "decision": "Potential reuse",
      "visible": false,
      "detail": "800 W is within the 48 V power rating; 4S voltage/current checks are below its limits. Confirm controller label, battery profile, hot-panel startup voltage and installation condition. No larger controller selected.",
      "source": "https://www.victronenergy.com/media/pg/Manual_SmartSolar_MPPT_150-35__150-45/en/technical-specifications.html"
    },
    {
      "name": "Series jumpers, PV home run & matched connectors",
      "quantity": "Lengths / quantities TBD",
      "decision": "Inspect before reuse",
      "visible": false,
      "detail": "Factory leads are 14 AWG, 0.7 m. Existing wire gauge, temperature/voltage ratings, route, voltage drop and connector manufacturer/family are unknown. Generic “MC4 compatible” does not establish safe mating. New extensions may be needed.",
      "source": "https://cdn.shopify.com/s/files/1/0938/4627/4366/files/HSP200N-64L_-_Manual.pdf?v=1779096675"
    },
    {
      "name": "Existing combiner / roof entry",
      "quantity": "Existing · topology unknown",
      "decision": "Conditional reuse or replacement",
      "visible": false,
      "detail": "The plan is one series string. A parallel combiner cannot be assumed to preserve 4S wiring. Internal bus connections, seals, terminals and DC ratings need inspection; reconfiguration or bypass may be needed. No replacement selected.",
      "source": "https://sgordon1024.github.io/solar-upgrade-guide/"
    },
    {
      "name": "PV isolation & overcurrent protection",
      "quantity": "Ratings / quantity TBD",
      "decision": "Verify or replace",
      "visible": false,
      "detail": "Verify DC voltage above design cold Voc, load-break capability, poles, cable protection and applicable requirements. Panel 20 A maximum series fuse is a ceiling, not a fuse recommendation. No device rating selected.",
      "source": "https://www.victronenergy.com/media/pg/Manual_SmartSolar_MPPT_150-35__150-45/en/installation.html"
    },
    {
      "name": "Battery cable, fuse & existing 48 V system",
      "quantity": "Existing · inspect",
      "decision": "Potential reuse",
      "visible": false,
      "detail": "Controller output remains limited to 35 A. Confirm cable ampacity, terminations, battery-side protection, BMS coordination and approved charge settings. 800 W alone does not require a battery upgrade.",
