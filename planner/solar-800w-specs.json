    },
    {
      "name": "Bonding, strain relief, roof seals & fasteners",
      "quantity": "Design dependent",
      "decision": "Required · unresolved",
      "visible": false,
      "detail": "Document the complete load path, corrosion isolation, panel clamp zones, rack limits, road vibration and wind uplift. Verify grounding/bonding and sealed cable supports. Fastener sizes and torque values are not selected.",
